border-radius:10px;

margin-top:8px;

background:#173d61;

color:white;

font-size:16px;

}

.submitBtn{

margin-top:25px;

width:100%;

padding:16px;

background:#2ecc71;

border:none;

border-radius:12px;

font-size:18px;

font-weight:bold;

cursor:pointer;

transition:.3s;

}

.submitBtn:hover{

background:#27ae60;

transform:translateY(-2px);

}

.note{

margin-top:20px;

background:#173d61;

padding:15px;

border-radius:12px;

font-size:14px;

line-height:24px;

}

.status{

margin-top:20px;

padding:15px;

border-radius:12px;

